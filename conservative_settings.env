# إعدادات محافظة جداً لتقليل الخسائر
# Conservative Settings to Minimize Losses

# حجم الصفقة - صغير جداً لتقليل المخاطر
DEFAULT_POSITION_SIZE=25

# إدارة المخاطر المحسنة
STOP_LOSS_PERCENTAGE=0.02          # 2% بدلاً من 5%
TAKE_PROFIT_PERCENTAGE=0.015       # 1.5% بدلاً من 0.1%
TRAILING_STOP_PERCENTAGE=0.025     # 2.5% trailing stop

# تقليل عدد الصفقات
MAX_DAILY_TRADES=3                 # 3 صفقات كحد أقصى يومياً
MAX_DAILY_LOSS=50                  # حد أقصى للخسائر اليومية $50

# تداول محافظ فقط في الأسهم الكبيرة
TRADING_MODE=conservative
MIN_MARKET_CAP=10000000000         # 10 مليار دولار كحد أدنى

# تعطيل الميزات المعقدة
TRAILING_STOP_ENABLED=false        # تعطيل trailing stop مؤقتاً
PARTIAL_PROFIT_TAKING_ENABLED=false
DYNAMIC_EXIT_ENABLED=false

# مؤشرات مبسطة
RSI_OVERSOLD=25                    # أكثر تحفظاً
RSI_OVERBOUGHT=75                  # أكثر تحفظاً
SUPPORT_THRESHOLD=0.01             # 1% بدلاً من 0.5%
RESISTANCE_THRESHOLD=0.01          # 1% بدلاً من 0.8%

# تداول في ساعات السوق العادية فقط
EXTENDED_HOURS_TRADING=false
PREMARKET_TRADING=false

# رموز آمنة فقط (الأسهم الكبيرة المستقرة)
SAFE_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,JPM,JNJ,PG